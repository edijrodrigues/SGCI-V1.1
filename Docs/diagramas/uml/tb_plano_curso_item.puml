@startuml SGCI Tabela Plano Curso Item
!theme plain
skinparam linestyle orthopedic
left to right direction

entity "tb_plano_curso_item" as tb_plano_curso_item #f8ffd1{
  * id_item : int [PK] <<auto_increment>>
  --
  * plano_curso_id : int [FK]
  * numero_item : int
  * objetivo_especifico : text
  * conteudo : text
  * atividades_recursos : text
'  * carga_horaria : decimal(5,2)
'  * criado_em : datetime [DF: CURRENT_TIMESTAMP]
'  * atualizado_em : datetime [DF: CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP]
}

' Notas para chaves e índices
'note bottom of tb_plano_curso_item
'  **Índices Secundários (Keys):**
'  * [KEY] fk_item_plano (plano_curso_id)
'end note

' --- Definição da tabela externa para amarração ---
'entity "tb_plano_curso" as tb_plano_curso {}

' --- Relacionamento baseado na CONSTRAINT do seu SQL ---
'tb_plano_curso "1" -- "0..*" tb_plano_curso_item : "fk_item_plano (CASCADE)"

@enduml