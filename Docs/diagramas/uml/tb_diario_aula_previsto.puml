@startuml SGCI Tabela Diário Aula Previsto
!theme plain
skinparam linestyle orthopedic
left to right direction

entity "tb_diario_aula_previsto" as tb_diario_aula_previsto #f8ffd1{
  * id_previsto : int [PK] <<auto_increment>>
  --
  * turma_id : int [FK]
  * plano_aula_id : int [FK]
  * data_prevista : date
  periodo_do_dia : enum('dia_inteiro','manha','tarde','noite') [DF: 'dia_inteiro']
  eh_letivo : tinyint(1) [DF: 1]
  status : enum('prevista','cancelada') [DF: 'prevista']
'  observacao : text
'  * ativo : tinyint(1) [DF: 1]
'  * criado_em : datetime [DF: CURRENT_TIMESTAMP]
'  * atualizado_em : datetime [DF: CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP]
'  deletado_em : datetime [DF: NULL]
}

' Notas para índices e chaves estrangeiras
'note bottom of tb_diario_aula_previsto
  '**Índices & Chaves:**
  '* [KEY] fk_previsto_planoaula (plano_aula_id)
  '* [INDEX] idx_previsto_turma_data (turma_id, data_prevista)
'end note

' --- Definição das tabelas externas para amarração ---
'entity "tb_plano_aula" as tb_plano_aula {}
'entity "tb_turma" as tb_turma {}

' --- Relacionamentos baseados nas CONSTRAINTS do seu SQL ---
'tb_plano_aula "1" -- "0..*" tb_diario_aula_previsto : "fk_previsto_planoaula (RESTRICT)"
'tb_turma "1" -- "0..*" tb_diario_aula_previsto : "fk_previsto_turma (CASCADE)"

@enduml