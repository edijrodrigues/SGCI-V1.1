@startuml SGCI Tabela Diário Aula
!theme plain
skinparam linestyle orthopedic
left to right direction

entity "tb_diario_aula" as tb_diario_aula #f8ffd1{
  * id_diario : int [PK] <<auto_increment>>
  --
  * previsto_id : int [FK] <<unique>>
  * turma_id : int [FK]
  * instrutor_id : int [FK]
  * plano_aula_id : int [FK]
  * data_aula : date
  conteudo_ministrado : text
  carga_horaria_real : decimal(5,2)
  ocorrencias : text
  status : enum('realizada','nao_realizada') [DF: 'realizada']
'  * ativo : tinyint(1) [DF: 1]
'  * criado_em : datetime [DF: CURRENT_TIMESTAMP]
'  * atualizado_em : datetime [DF: CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP]
'  deletado_em : datetime [DF: NULL]
}

' Notas para índices e chaves únicas
'note bottom of tb_diario_aula
'  **Chaves Únicas & Índices:**
'  * [UQ] ux_diario_previsto (previsto_id)
'  * [KEY] fk_diario_instrutor (instrutor_id)
'  * [KEY] fk_diario_planoaula (plano_aula_id)
'  * [INDEX] idx_diario_turma_data (turma_id, data_aula)
'end note

' --- Definição das tabelas externas para o relacionamento ---
'entity "tb_diario_aula_previsto" as tb_diario_aula_previsto {}
'entity "tb_turma" as tb_turma {}
'entity "tb_instrutor" as tb_instrutor {}
'entity "tb_plano_aula" as tb_plano_aula {}

' --- Relacionamentos baseados nas CONSTRAINTS do seu SQL ---
'tb_diario_aula_previsto "1" -- "1" tb_diario_aula : "fk_diario_previsto (RESTRICT)"
'tb_turma "1" -- "0..*" tb_diario_aula : "fk_diario_turma (RESTRICT)"
'tb_instrutor "1" -- "0..*" tb_diario_aula : "fk_diario_instrutor (RESTRICT)"
'tb_plano_aula "1" -- "0..*" tb_diario_aula : "fk_diario_planoaula (RESTRICT)"

@enduml