@startuml SGCI Tabela Frequência Aluno
!theme plain
skinparam linestyle orthopedic
left to right direction

entity "tb_frequencia_aluno" as tb_frequencia_aluno #f8ffd1{
  * id_frequencia : int [PK] <<auto_increment>>
  --
  * matricula_id : int [FK]
  * turma_id : int [FK]
  * plano_aula_id : int [FK]
  * instrutor_id : int [FK]
  * data_aula : date
  * status_frequencia : enum('presente','falta','atraso','justificado') [DF: 'presente']
  observacao : text
'  * ativo : tinyint(1) [DF: 1]
'  * criado_em : datetime [DF: CURRENT_TIMESTAMP]
'  * atualizado_em : datetime [DF: CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP]
'  deletado_em : datetime [DF: NULL]
}

' Notas para índices e chaves compostas
'note bottom of tb_frequencia_aluno
'  **Chaves Únicas & Índices:**
'  * [UQ] uq_frequencia_unica (matricula_id, plano_aula_id, data_aula)
'  * [KEY] fk_freq_turma (turma_id)
'  * [KEY] fk_freq_plano_aula (plano_aula_id)
'  * [KEY] fk_freq_instrutor (instrutor_id)
'end note

' --- Definição das tabelas externas para o relacionamento ---
'entity "tb_matricula" as tb_matricula {}
'entity "tb_turma" as tb_turma {}
'entity "tb_plano_aula" as tb_plano_aula {}
'entity "tb_instrutor" as tb_instrutor {}

' --- Relacionamentos baseados nas CONSTRAINTS do seu SQL ---
'tb_matricula "1" -- "0..*" tb_frequencia_aluno : "fk_freq_matricula (RESTRICT)"
'tb_turma "1" -- "0..*" tb_frequencia_aluno : "fk_freq_turma (RESTRICT)"
'tb_plano_aula "1" -- "0..*" tb_frequencia_aluno : "fk_freq_plano_aula (RESTRICT)"
'tb_instrutor "1" -- "0..*" tb_frequencia_aluno : "fk_freq_instrutor (RESTRICT)"

@enduml